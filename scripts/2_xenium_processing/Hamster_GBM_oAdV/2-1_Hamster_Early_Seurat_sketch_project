# 3) QC
obj <- subset(obj, subset = nCount_Xenium >= 10)
cat("Cells after QC:", ncol(obj), "\n")

# 4) Normalize/Reduce/Cluster with Sketch -> UMAP on sketch (model) -> ProjectData
DefaultAssay(obj) <- "Xenium"
obj <- NormalizeData(obj, verbose = FALSE)
obj <- FindVariableFeatures(obj, verbose = FALSE)

# Sketch for speed
obj <- SketchData(object = obj, ncells = 50000, method = "LeverageScore", sketched.assay = "sketch")
stopifnot("sketch" %in% names(obj@assays))

# Work on sketch
DefaultAssay(obj) <- "sketch"
obj <- SCTransform(obj, assay = "sketch", vst.flavor = "v2", verbose = FALSE)
obj <- RunPCA(obj, verbose = FALSE)
stopifnot("pca" %in% names(obj@reductions))

# UMAP on sketch with return.model = TRUE using reduction "pca" (creates "umap")
obj <- RunUMAP(obj, reduction = "pca", dims = 1:30, return.model = TRUE)
stopifnot("umap" %in% names(obj@reductions))
stopifnot(!is.null(obj@reductions$umap@misc$model))

# Neighbors/clusters on sketch
obj <- FindNeighbors(obj, reduction = "pca", dims = 1:30, verbose = FALSE)
obj <- FindClusters(obj, resolution = 0.15, verbose = FALSE)

# Project sketch -> full data (creates "pca.full" and "full.umap" if absent)
DefaultAssay(obj) <- "Xenium"
obj <- ProjectData(
  object             = obj,
  assay              = "Xenium",
  full.reduction     = "pca.full",
  sketched.assay     = "sketch",
  sketched.reduction = "pca",
  umap.model         = "umap",
  dims               = 1:30,
  refdata            = list(cluster_full = "seurat_clusters")
)

# ASSERT: projected reductions exist
stopifnot("pca.full" %in% names(obj@reductions))
stopifnot("full.umap" %in% names(obj@reductions))

# 4.5) GUARDS before plotting: NA-safe fields + "no drop" assertion
# NA-safe plotting metadata
obj$Condition_plot <- ifelse(is.na(obj$Condition), "Unknown", obj$Condition)
obj$TimeGroup_plot <- ifelse(is.na(obj$TimeGroup), "NA", obj$TimeGroup)

# Identity safety
obj$cluster_full <- as.character(obj$cluster_full)
obj$cluster_full[is.na(obj$cluster_full)] <- "unassigned"
obj$cluster_full <- factor(obj$cluster_full)
Idents(obj) <- "cluster_full"

# Assert: every cell has UMAP coords
stopifnot(nrow(Embeddings(obj, "full.umap")) == ncol(obj))


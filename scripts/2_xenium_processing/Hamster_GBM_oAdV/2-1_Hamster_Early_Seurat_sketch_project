# 1) Helper functions (ASCII-safe)
.standardize_names <- function(nm) {
  nm <- iconv(nm, from = "", to = "UTF-8", sub = "")
  nm <- trimws(nm)
  nm <- tolower(nm)
  nm <- gsub("[^a-z0-9]+", "_", nm)
  nm <- gsub("^_|_$", "", nm)
  nm
}

.detect_delim <- function(fp) {
  con <- file(fp, open = "r", encoding = "UTF-8")
  on.exit(close(con), add = TRUE)
  line <- ""
  repeat {
    line <- suppressWarnings(readLines(con, n = 1, warn = FALSE))
    if (length(line) == 0) break
    if (!startsWith(line, "#")) break
  }
  if (length(line) == 0 || nchar(line) == 0) return(",")
  commas <- stringr::str_count(line, ",")
  semis  <- stringr::str_count(line, ";")
  if (semis > commas) ";" else ","
}

# Read a *_cells_stats.csv -> tibble(cell_id, spot_id)
.read_cells_stats_one <- function(fp, spot_id) {
  delim <- .detect_delim(fp)
  df <- tryCatch(
    readr::read_delim(fp, delim = delim, comment = "#", show_col_types = FALSE,
                      locale = locale(encoding = "UTF-8"), trim_ws = TRUE),
    error = function(e) NULL
  )
  if (is.null(df)) {
    if (delim == ",") {
      df <- tryCatch(read.csv(fp, comment.char = "#", check.names = FALSE), error = function(e) NULL)
    } else {
      df <- tryCatch(read.delim(fp, sep = ";", comment.char = "#", check.names = FALSE), error = function(e) NULL)
    }
    if (!is.null(df)) df <- tibble::as_tibble(df)
  }
  if (is.null(df)) {
    message("  Could not read: ", fp)
    return(NULL)
  }
  colnames(df) <- .standardize_names(colnames(df))

  # Accept cell id column names
  candidates <- c("cell_id","cell")
  found <- intersect(candidates, colnames(df))
  if (length(found) == 0) {
    message("  Could not find a cell id column in: ", fp)
    message("  First columns seen: ", paste(head(colnames(df), 8), collapse = ", "))
    return(NULL)
  }
  cid <- found[1]
  df %>%
    dplyr::select(cell_id = all_of(cid)) %>%
    dplyr::mutate(spot_id = as.character(spot_id))
}

# Parse Condition and TimeGroup from spot_id
parse_spot_annotations <- function(spot_ids) {
  s <- trimws(spot_ids)

  cond <- ifelse(grepl("\\bNT\\b", s, ignore.case = TRUE), "NT",
          ifelse(grepl("\\bPBS\\b", s, ignore.case = TRUE), "PBS",
          ifelse(grepl("\\bRGD\\b", s, ignore.case = TRUE), "RGD", NA_character_)))

  tg_raw <- toupper(str_extract(s, "\\bG[1-4]\\b"))
  tg <- ifelse(cond %in% c("PBS","RGD"), tg_raw, NA_character_)

  tibble::tibble(
    spot_id = spot_ids,
    Condition = cond,
    TimeGroup = tg,
  )
}

# Attach spot_id + derived annotations
attach_spot_ids_to_obj <- function(obj, slide_tag, spot_dir) {
  if (!dir.exists(spot_dir)) {
    message("No Spot Segmentation directory at: ", spot_dir)
    return(obj)
  }
  files <- list.files(spot_dir, pattern = "_cells_stats\\.csv$", full.names = TRUE)
  if (length(files) == 0) {
    message("No *_cells_stats.csv files under: ", spot_dir)
    return(obj)
  }

  df_cells <- lapply(files, function(fp) {
    base <- sub("_cells_stats\\.csv$", "", basename(fp))  # may include spaces
    .read_cells_stats_one(fp, spot_id = base)
  })
  df_cells <- df_cells[!vapply(df_cells, is.null, logical(1))]
  spot_map <- dplyr::bind_rows(df_cells)
  if (nrow(spot_map) == 0) {
    message("Parsed 0 rows from cells_stats in: ", spot_dir)
    return(obj)
  }

  spot_map <- spot_map %>%
    mutate(cell_key = paste0(slide_tag, "_", as.character(cell_id))) %>%
    distinct(cell_key, .keep_all = TRUE)

  idx <- intersect(spot_map$cell_key, colnames(obj))
  if (length(idx) == 0) {
    message("Spot Segmentation parsed but 0 cells matched colnames in Seurat object.")
    return(obj)
  }

  vec <- setNames(spot_map$spot_id[match(idx, spot_map$cell_key)], idx)
  obj <- AddMetaData(obj, metadata = vec, col.name = "spot_id")
  cat("Attached spot_id to", length(idx), "cells.\n")

  # Derive annotations and attach
  ann_spot <- parse_spot_annotations(unique(spot_map$spot_id))
  map <- tibble::tibble(cell_key = colnames(obj), spot_id = obj$spot_id) %>%
    left_join(ann_spot, by = "spot_id")
  df <- data.frame(
    row.names = map$cell_key,
    Condition = map$Condition,
    TimeGroup = map$TimeGroup,
    stringsAsFactors = FALSE
  )
  obj <- AddMetaData(obj, df)
  obj
}


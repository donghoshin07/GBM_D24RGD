  slide_tag,
  colnames(obj),
  sep = "_"
)

# Attach Metadata
obj <- attach_spot_ids_to_obj(
  obj,
  slide_tag = slide_tag,
  spot_dir = spot_dir
)

cat("Total cells loaded:", ncol(obj), "\n")

print(
  obj@meta.data %>%
    count(Condition, Region)
)

# Exclude NT Regions and Keep PBS/RGD Only
obj <- subset(
  obj,
  subset =
    Condition %in% c("PBS", "RGD") &
    Region != "NT"
)

cat("Cells after PBS/RGD filtering and NT exclusion:", ncol(obj), "\n")

print(
  obj@meta.data %>%
    count(Condition)
)

# QC
obj <- subset(
  obj,
  subset = nCount_Xenium >= 10
)

cat("Cells after QC:", ncol(obj), "\n")

# Normalization
DefaultAssay(obj) <- "Xenium"

obj <- NormalizeData(
  obj,
  verbose = FALSE
)

obj <- FindVariableFeatures(
  obj,
  verbose = FALSE
)

# Sketch + SCTransform
obj <- SketchData(
  object = obj,
  ncells = 50000,
  method = "LeverageScore",
  sketched.assay = "sketch"
)

DefaultAssay(obj) <- "sketch"

obj <- SCTransform(
  obj,
  assay = "sketch",
  vst.flavor = "v2",
  verbose = FALSE
)

obj <- RunPCA(
  obj,
  verbose = FALSE
)

obj <- RunUMAP(
  obj,
  reduction = "pca",
  dims = 1:30,
  return.model = TRUE
)

obj <- FindNeighbors(
  obj,
  reduction = "pca",
  dims = 1:30,
  verbose = FALSE
)

obj <- FindClusters(
  obj,
  resolution = 0.2,
  verbose = FALSE
)

# Project To Full Dataset
DefaultAssay(obj) <- "Xenium"

obj <- ProjectData(
  object             = obj,
  assay              = "Xenium",
  full.reduction     = "pca.full",
  sketched.assay     = "sketch",
  sketched.reduction = "pca",
  umap.model         = "umap",
  dims               = 1:30,
  refdata            = list(
    cluster_full = "seurat_clusters"
  )
)

stopifnot("full.umap" %in% names(obj@reductions))

obj$cluster_full <- factor(obj$cluster_full)

# Differential Expression
DefaultAssay(obj) <- "sketch"

Idents(obj) <- "Condition"

markers_RGD_vs_PBS <- FindMarkers(
  obj,
  ident.1 = "RGD",
  ident.2 = "PBS",
  only.pos = FALSE,
  min.pct = 0.1,
  logfc.threshold = 0.1
)


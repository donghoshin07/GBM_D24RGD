# Helper Functions
.standardize_names <- function(nm) {
  nm <- iconv(nm, from = "", to = "UTF-8", sub = "")
  nm <- trimws(nm)
  nm <- tolower(nm)
  nm <- gsub("[^a-z0-9]+", "_", nm)
  nm <- gsub("^_|_$", "", nm)
  nm
}

.detect_delim <- function(fp) {

  con <- file(fp, open = "r", encoding = "UTF-8")
  on.exit(close(con), add = TRUE)

  line <- ""

  repeat {

    line <- suppressWarnings(
      readLines(con, n = 1, warn = FALSE)
    )

    if (length(line) == 0) break
    if (!startsWith(line, "#")) break
  }

  if (length(line) == 0 || nchar(line) == 0) return(",")

  commas <- stringr::str_count(line, ",")
  semis  <- stringr::str_count(line, ";")

  if (semis > commas) ";" else ","
}

.read_cells_stats_one <- function(fp, spot_id) {

  delim <- .detect_delim(fp)

  df <- tryCatch(
    readr::read_delim(
      fp,
      delim = delim,
      comment = "#",
      show_col_types = FALSE,
      trim_ws = TRUE
    ),
    error = function(e) NULL
  )

  if (is.null(df)) {
    message("Failed reading: ", fp)
    return(NULL)
  }

  colnames(df) <- .standardize_names(colnames(df))

  candidates <- c(
    "cell_id",
    "cellid",
    "cell"
  )

  found <- intersect(candidates, colnames(df))

  if (length(found) == 0) {
    message("Could not identify cell ID column in: ", basename(fp))
    message("Columns detected:")
    print(colnames(df))
    return(NULL)
  }

  cid <- found[1]

  df %>%
    dplyr::select(cell_id = all_of(cid)) %>%
    dplyr::mutate(spot_id = as.character(spot_id))
}

# Parse Spot Metadata
parse_spot_annotations <- function(spot_ids) {

  condition <- case_when(
    grepl("^RGDOX-", spot_ids, ignore.case = TRUE) ~ "RGDOX",
    grepl("^RGD-",   spot_ids, ignore.case = TRUE) ~ "RGD",
    grepl("^PBS-",   spot_ids, ignore.case = TRUE) ~ "PBS",
    TRUE ~ NA_character_
  )

  hamster_id <- stringr::str_extract(
    spot_ids,
    "(?<=-)[0-9]+"
  )

  region <- case_when(
    grepl("_1$", spot_ids) ~ "1",
    grepl("_2$", spot_ids) ~ "2",
    grepl("_NT$", spot_ids, ignore.case = TRUE) ~ "NT",
    grepl("_border$", spot_ids, ignore.case = TRUE) ~ "border",
    TRUE ~ "main"
  )

  tibble(
    spot_id   = spot_ids,
    Condition = condition,
    HamsterID = hamster_id,
    Region    = region
  )
}

# Attach Spot Metadata to Seurat Object
attach_spot_ids_to_obj <- function(obj, slide_tag, spot_dir) {

  files <- list.files(
    spot_dir,
    pattern = "_cells_stats\\.csv$",
    full.names = TRUE
  )

  if (length(files) == 0) {
    stop("No *_cells_stats.csv files found.")
  }

  df_list <- lapply(
    files,
    function(fp) {

      spot_name <- sub(
        "_cells_stats\\.csv$",
        "",
        basename(fp)
      )

      .read_cells_stats_one(
        fp,
        spot_id = spot_name
      )
    }
  )

  df_list <- df_list[
    !vapply(df_list, is.null, logical(1))
  ]

  spot_map <- bind_rows(df_list)

  if (nrow(spot_map) == 0) {
    stop("No valid cell mappings found.")
  }

  spot_map <- spot_map %>%
    mutate(
      cell_key = paste0(
        slide_tag,
        "_",
        as.character(cell_id)
      )
    ) %>%
    distinct(cell_key, .keep_all = TRUE)

  idx <- intersect(
    spot_map$cell_key,
    colnames(obj)
  )

  cat("Matched cells:", length(idx), "\n")

  vec <- setNames(
    spot_map$spot_id[match(idx, spot_map$cell_key)],
    idx
  )

  obj <- AddMetaData(
    obj,
    metadata = vec,
    col.name = "spot_id"
  )

  ann <- parse_spot_annotations(
    unique(spot_map$spot_id)
  )

  map <- tibble(
    cell_key = colnames(obj),
    spot_id  = obj$spot_id
  ) %>%
    left_join(
      ann,
      by = "spot_id"
    )

  df <- data.frame(
    row.names = map$cell_key,
    Condition = map$Condition,
    HamsterID = map$HamsterID,
    Region    = map$Region,
    stringsAsFactors = FALSE
  )

  obj <- AddMetaData(
    obj,
    metadata = df
  )

  obj
}

# Load Xenium
stopifnot(dir.exists(outs_path))

